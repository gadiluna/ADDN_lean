import Counting.EncodingNetworkViews

namespace Counting.StackMachine.NetworkVista

/-- Compact messages generated by the offline simulator in explicit sender
order. An edge contributes its binary multiplicity once, never that many
copies of the sender's view. -/
def receivedPairs (receiver:Nat) : List (Executable.Vista×Array Nat) → List (Executable.Vista×Nat)
  | []=>[]
  | (vista,row)::rest=>
    let count:=row[receiver]?.getD 0
    if count=0 then receivedPairs receiver rest else (vista,count)::receivedPairs receiver rest

theorem receivedPairs_length_le (receiver:Nat) (pairs:List (Executable.Vista×Array Nat)) :
    (receivedPairs receiver pairs).length≤pairs.length:=by
  induction pairs with
  | nil=>rfl
  | cons pair pairs ih=>
    obtain ⟨vista,row⟩:=pair
    simp only [receivedPairs,List.length_cons]
    split
    · exact ih.trans (Nat.le_succ _)
    · simpa only [List.length_cons] using Nat.succ_le_succ ih

theorem receivedPairs_positive (receiver:Nat) (pairs:List (Executable.Vista×Array Nat)) :
    ∀message∈receivedPairs receiver pairs,0 < message.2:=by
  induction pairs with
  | nil=>simp [receivedPairs]
  | cons pair pairs ih=>
    obtain ⟨vista,row⟩:=pair
    simp only [receivedPairs]
    split
    · exact ih
    · intro message present
      simp only [List.mem_cons] at present
      rcases present with rfl|present
      · dsimp;omega
      · exact ih message present

end Counting.StackMachine.NetworkVista
