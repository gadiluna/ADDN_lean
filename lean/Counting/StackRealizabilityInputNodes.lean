import Counting.StackRealizabilityInputValidate

namespace Counting.StackMachine.RealizabilityCheck
open Routine EncodingPrograms
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000

def inputNodes : Routine 98 := sequence (ofProgram (ListPrograms.copyProgram 97 99 70 0))
  (sequence (readComponent DagParser.nodes 80) (clear 70))

def inputNodesStore (vista : Executable.Vista) (values : List Nat) (ell order : Nat)
    (status : List Bool) : Store 98 :=
  Function.update (inputFieldsStore vista values ell order status) 80
    ((Encoding.list Encoding.node).encode vista.nodes.toList)

/-- The node-list copy consumed by all later scans is generated by the
actual parser. The original vista and all other extracted fields survive. -/
theorem inputNodes_executes (vista : Executable.Vista) (values : List Nat) (ell order : Nat)
    (accepted : Bool) (tail : List Bool) :
    ∃ time ≤ 4000*((Encoding.vista.encode vista).length+1)^4,
      Executes inputNodes (inputFieldsStore vista values ell order (accepted::tail)) time
        (inputNodesStore vista values ell order (accepted::tail)) := by
  let start := inputFieldsStore vista values ell order (accepted::tail)
  have copying := copy_executes 97 (99:Fin 100) 70 0 (by decide) (by decide) (by decide)
    start (by simp [start,inputFieldsStore])
  have fromAt : start 99=Encoding.vista.encode vista := by simp [start,inputFieldsStore]
  have empty : start 70=[] := by simp [start,inputFieldsStore]
  rw [fromAt,empty,List.append_nil] at copying
  let copied := Function.update start 70 (Encoding.vista.encode vista)
  obtain ⟨time,bound,parsing⟩ := readComponent_executes DagParser.nodes (80:Fin 100)
    (by decide) (by decide) copied vista.nodes.toList (Encoding.natural.encode vista.bottom)
    accepted tail (by simp only [copied,Function.update_self];rfl)
    (by simp [copied,start,inputFieldsStore]) (by simp [copied,start,inputFieldsStore])
    (by simp [copied,start,inputFieldsStore])
    (by intro i a b c;fin_cases i <;> simp_all [copied,start,inputFieldsStore,componentRoles])
  let parsed := Function.update (Function.update copied 70 (Encoding.natural.encode vista.bottom))
    80 ((Encoding.list Encoding.node).encode vista.nodes.toList)
  have clearing := clear_executes (70:Fin 100) parsed
  have suffixAt : parsed 70=Encoding.natural.encode vista.bottom := by simp [parsed]
  rw [suffixAt] at clearing
  have final : Function.update parsed 70 []=inputNodesStore vista values ell order (accepted::tail) := by
    funext r
    by_cases a:r=70 <;> by_cases b:r=80 <;> simp_all [parsed,copied,start,inputNodesStore,inputFieldsStore]
  rw [final] at clearing
  change time ≤ 3849*((Encoding.vista.encode vista).length+1)^4+
    2*((Encoding.list Encoding.node).encode vista.nodes.toList).length+2 at bound
  have split : (Encoding.vista.encode vista).length=
      ((Encoding.list Encoding.node).encode vista.nodes.toList).length+(Encoding.natural.encode vista.bottom).length := by
    change (((Encoding.list Encoding.node).encode vista.nodes.toList)++
      Encoding.natural.encode vista.bottom).length=_
    exact List.length_append
  have linear := Nat.le_self_pow (by decide : 4≠0) ((Encoding.vista.encode vista).length+1)
  have one := Nat.one_le_pow 4 ((Encoding.vista.encode vista).length+1) (by omega)
  exact ⟨_,by omega,
    copying.sequence (parsing.sequence clearing)⟩

end Counting.StackMachine.RealizabilityCheck
